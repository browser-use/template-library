# Get your key at https://cloud.browser-use.com/dashboard/settings?tab=api-keys&new
BROWSER_USE_API_KEY=your-key-here

# Site to log in to. The agent may only visit this domain and its subdomains.
LOGIN_DOMAIN=example.com
LOGIN_URL=https://example.com/login

# Credentials. The LLM sees only placeholder names, never these values.
SITE_USERNAME=you@example.com
SITE_PASSWORD=your-password
# The TOTP secret (base32 text behind the 2FA QR code), not a 6-digit code
SITE_TOTP_SECRET=your-base32-totp-secret

# Optional: cloud profile that keeps the login between runs
# Create one at https://cloud.browser-use.com/settings?tab=profiles
CLOUD_PROFILE_ID=
